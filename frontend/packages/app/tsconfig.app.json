{
	"extends": "@marketplace/shared-config/typescript/react-library",
	"compilerOptions": {
		"jsx": "react-jsx",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"types": ["jest", "@testing-library/jest-dom"],
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

		
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"@marketplace/design-system": ["../design-system/src"],
            "@marketplace/design-system/*": ["../design-system/src/*"]
		}
	},
	"include": ["src", "setupTests.d.ts"]
}
